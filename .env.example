BANK_Y_API_URL=http://bank-y-backend:8020
BANK_X_API_KEY=<bank-x-api-key>
BANK_Y_API_KEY=<bank-y-api-key>
BANK_HMAC_SECRET=<shared-hmac-secret>
ADMIN_EMAIL=admin@minipay.com
ADMIN_PASSWORD=<strong-admin-password>
