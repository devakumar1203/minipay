DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>:5432/<db>
REDIS_URL=redis://<host>:6379/0
RABBITMQ_URL=amqp://<user>:<password>@<host>:5672/
JWT_SECRET=<your-strong-secret-here>
